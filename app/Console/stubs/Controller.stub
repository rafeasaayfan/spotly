<?php

namespace {{ namespace }};

use App\Http\Controllers\Controller;
use App\Models\{{ model }};
use App\Traits\DataTableTrait;
use Illuminate\Http\Request;
use {{ requestNamespace }}\Store{{ model }}Request;
use {{ requestNamespace }}\Update{{ model }}Request;

class {{ controllerName }} extends Controller
{
    use DataTableTrait;

    /**
     * Display a listing of the resource.
     */
    public function index(Request $request)
    {
        $query = {{ model }}::query();

        $columnsSearching = {{ columnsSearching }};
        $columnsSelection = {{ selectionCols }};
        $relations = {{ relations }};

        $data = $this->dataTable($query, $request, $columnsSearching, $columnsSelection, $relations);

        // $data->transform(function ($item) {
        //    $item->image = $item->getFirstMediaUrl('image');
        //    return $item;
        // });

        return $this->inertiaRender('dashboard/pages/{{ folder }}/{{ pluralModel }}', ['{{ pluralVariable }}' => $data]);
    }

    /**
     * Show the form for creating a new resource.
     */
    public function create()
    {
        try {
            {{ createEditrelations }}

            return $this->jsonSuccess('', [
                {{ createEditrelationsReturn }}
            ]);
        } catch (\Exception $e) {
            return $this->logJsonResponse('{{ controllerName }}@create', $e, 'An error when fetching the create page');
        }
    }

    /**
     * Store a newly created resource in storage.
     */
    public function store(Store{{ model }}Request $request)
    {
        try {
            $validated = $request->validated();
            // unset($validated['image']);

            ${{ modelVariable }} = new {{ model }}($validated);

            // if ($request->hasFile('image') && $request->file('image')->isValid()) {
                // ${{ modelVariable }}->addMediaFromRequest('image')
                // ->toMediaCollection('image');
            // }

            ${{ modelVariable }}->save();

            return $this->redirectSuccess('dashboard.{{ folder }}.index', '{{ model }} created successfully');
        } catch (\Exception $e) {
            return $this->logResponse('{{ controllerName }}@store', $e, 'An error occurred while creating the {{ model }}');
        }
    }

    /**
     * Display the specified resource.
     */
    public function show(string $id)
    {
        try {
            ${{ modelVariable }} = {{ model }}::findOrFail($id);

            // ${{ modelVariable }}->image = ${{ modelVariable }}->getFirstMediaUrl('image');

            // ${{ modelVariable }} = $this->flattenRelationData($query, ['..._name']);

            return $this->jsonSuccess('', [
                'data' => ${{ modelVariable }},
            ]);
        } catch (\Exception $e) {
            return $this->logJsonResponse('{{ controllerName }}@show', $e, 'An error when fetching the show page');
        }
    }

    /**
     * Show the form for editing the specified resource.
     */
    public function edit(string $id)
    {
        try {
            ${{ modelVariable }} = {{ model }}::findOrFail($id);

            // ${{ modelVariable }}->image = ${{ modelVariable }}->getFirstMediaUrl('image');

            {{ createEditrelations }}

            return $this->jsonSuccess('', [
                'data' => ${{ modelVariable }},
                {{ createEditrelationsReturn }}
            ]);
        } catch (\Exception $e) {
            return $this->logJsonResponse('{{ controllerName }}@edit', $e, 'An error when fetching the edit page');
        }
    }

    /**
     * Update the specified resource in storage.
     */
    public function update(Update{{ model }}Request $request, {{ model }} ${{ modelVariable }})
    {
        try {
            $validated = $request->validated();
            // unset($validated['image']);

            ${{ modelVariable }}->fill($validated);

            // if ($request->hasFile('image') && $request->file('image')->isValid()) {
                // ${{ modelVariable }}->clearMediaCollection('image');
                // ${{ modelVariable }}->addMediaFromRequest('image')
                // ->toMediaCollection('image');
            // }

            ${{ modelVariable }}->save();

            return $this->redirectSuccess('dashboard.{{ folder }}.index', '{{ model }} updated successfully');
        } catch (\Exception $e) {
            return $this->logResponse('{{ controllerName }}@update', $e, 'An error occurred while updating the {{ model }}');
        }
    }

    /**
     * Remove the specified resource from storage.
     */
    public function destroy(Request $request)
    {
        try {
            $validated = $request->validate([
                'ids' => 'required|array',
                'ids.*' => 'integer|exists:{{ pluralVariable }},id',
            ]);
    
            {{ model }}::destroy($validated['ids']);
    
            return $this->backSuccess('{{ model }}(s) deleted successfully');
        } catch (\Exception $e) {
            return $this->logResponse('{{ controllerName }}@destroy', $e, 'An error occurred while deleting the {{ model }}(s)');
        }
    }

    /**
     * Toggle the active status of the specified resource.
    */
    public function toggleActive(Request $request, $id)
    {
        try {
            ${{ modelVariable }} = {{ model }}::findOrFail($id);
    
            $validated = $request->validate([
                'is_active' => 'required|boolean',
            ]);
    
            ${{ modelVariable }}->update([
                'is_active' => $validated['is_active'],
            ]);
    
            $message = $validated['is_active']
                ? '{{ model }} activated successfully.'
                : '{{ model }} deactivated successfully.';
    
            return $this->backSuccess($message);
        } catch (\Exception $e) {
            return $this->logResponse('{{ controllerName }}@toggleActive', $e, 'An error occurred while updating the {{ model }} status');
        }
    }

    /**
     * Change the status of the specified resource.
    */
    public function changeStatus(Request $request, $id)
    {
        try {
            $validated = $request->validate([
                'status' => 'required|string|in:active,inactive,banned',
            ]);

            ${{ modelVariable }} = {{ model }}::findOrFail($id);
            ${{ modelVariable }}->update(['status' => $validated['status']]);

            $message = $validated['status'] === 'active'
                ? 'User activated successfully.'
                : 'User deactivated successfully.';

            if ($validated['status'] === 'inactive') $message = 'The user is now inactive.';
            if ($validated['status'] === 'banned') $message = 'The user is now banned.';

            return $this->backSuccess($message);
        } catch (\Exception $e) {
            return $this->logResponse('{{ controllerName }}@changeStatus', $e, 'An error occurred while updating the {{ model }} status');
        }
    }
}
